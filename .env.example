# Email engine configuration (src/pages/api/enquiry.ts)
# Copy to .env and fill with the mailbox's real SMTP credentials.
# Without SMTP_HOST the endpoint runs in DRY-RUN mode: submissions succeed
# and the composed email is logged to the server console instead of sent.

# The sending mailbox — Skyrule's Zoho Mail account. Port 465 = implicit TLS
# (587 = STARTTLS also works). SMTP_PASS is a Zoho *app-specific password*
# (Zoho Mail -> Settings -> Security -> App Passwords), not the login password;
# the mailbox's plan must include IMAP/POP/SMTP access (paid Mail plans do,
# the Forever Free plan does not).
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=enquiries@skyruletravels.com
SMTP_PASS=

# Where enquiries are delivered (defaults to enquiries@skyruletravels.com)
MAIL_TO=enquiries@skyruletravels.com
# From header shown on the emails (defaults to SMTP_USER). Zoho only allows
# the authenticated address or a verified alias — leave empty.
MAIL_FROM=

# --- Promo admin ---
# Signing key for magic links and admin sessions. Generate with:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
AUTH_SECRET=

# Comma-separated addresses allowed to sign in. THIS IS THE ACCESS CONTROL —
# anyone listed here can publish to the live site. Empty allows nobody.
ADMIN_EMAILS=

# Supplied by the Vercel Blob integration; run `vercel env pull` after enabling it.
BLOB_READ_WRITE_TOKEN=
