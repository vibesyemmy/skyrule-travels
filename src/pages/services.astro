---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/button/Button.astro";
---
<BaseLayout navbarStartScrolled title="Our Services | Skyrule Travels" description="Everything a trip needs under one roof — flights, hotels, visa assistance, packages, car hire and protocol services, booked and supported by one team in Lagos.">
  <!-- White content sheet (same rationale as about.astro/contact.astro):
       the fixed footer sits behind the content sheet. Ships on /services only.
       (The closing band paints its own dark background.) -->
  <style is:global>.scroll-wrapper { background-color: var(--background-color--background-primary); }</style>
  <section class="padding-global"><div class="container-large"><div class="padding-section-large">
    <h1 class="heading-style-h1">Our Services</h1>
    <p class="body-text">Everything a trip needs under one roof — booked, confirmed and supported by one team in Lagos.</p>
  </div></div></section>
  <section class="padding-global"><div class="container-large"><div class="padding-section-large no-padding-top"><div class="home-products_component">
    <a data-theme="dark" href="/contact" class="home-products_card w-inline-block"><div class="home-products_content-top"><div class="home-products_text-wrap"><div class="home-products_header-wrap"><h2 class="home-product_header">Flights</h2></div><div class="home-products_body-wrap"><div class="text-size-regular">Round trip or one way, local or international — the best routes and fares, booked and managed for you.</div></div></div><div class="home-products_icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 17" fill="none"><g clip-path="url(#clip0_6401_1558)"><path d="M10.9541 3.45557L6.00455 3.49545L5.99226 5.02155L10.5927 4.98503L3.05492 12.5549L4.12551 13.6255L11.6959 6.02298L11.6583 10.6887L13.1844 10.6764L13.2249 5.72629C13.2282 5.11964 12.9913 4.5402 12.5657 4.11468C12.1402 3.68916 11.5608 3.45218 10.9541 3.45557Z" fill="currentColor"></path></g><defs><clippath id="clip0_6401_1558"><rect width="16" height="16" fill="currentColor" transform="translate(0 0.5)"></rect></clippath></defs></svg></div></div><div class="home-products_image-wrap"><img src="/images/skyrule-svc-flights.jpg" loading="lazy" alt="Airplane wing over clouds seen through a cabin window" class="home-products_image"/><div class="home-products_image-overlay"></div></div></a>
    <a data-theme="dark" href="/contact" class="home-products_card w-inline-block"><div class="home-products_content-top"><div class="home-products_text-wrap"><div class="home-products_header-wrap"><h2 class="home-product_header">Hotels</h2></div><div class="home-products_body-wrap"><div class="text-size-regular">From business hotels to beach resorts — stays matched to your plans and your budget, confirmed before you fly.</div></div></div><div class="home-products_icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 17" fill="none"><g clip-path="url(#clip0_6401_1558)"><path d="M10.9541 3.45557L6.00455 3.49545L5.99226 5.02155L10.5927 4.98503L3.05492 12.5549L4.12551 13.6255L11.6959 6.02298L11.6583 10.6887L13.1844 10.6764L13.2249 5.72629C13.2282 5.11964 12.9913 4.5402 12.5657 4.11468C12.1402 3.68916 11.5608 3.45218 10.9541 3.45557Z" fill="currentColor"></path></g><defs><clippath id="clip0_6401_1558"><rect width="16" height="16" fill="currentColor" transform="translate(0 0.5)"></rect></clippath></defs></svg></div></div><div class="home-products_image-wrap"><img src="/images/skyrule-svc-hotels.jpg" loading="lazy" alt="A warmly lit hotel suite with a large bed" class="home-products_image"/><div class="home-products_image-overlay"></div></div></a>
    <a data-theme="dark" href="/contact" class="home-products_card w-inline-block"><div class="home-products_content-top"><div class="home-products_text-wrap"><div class="home-products_header-wrap"><h2 class="home-product_header">Visa Assistance</h2></div><div class="home-products_body-wrap"><div class="text-size-regular">Applications done right the first time — documents, requirements and timelines handled; renewals and extensions included.</div></div></div><div class="home-products_icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 17" fill="none"><g clip-path="url(#clip0_6401_1558)"><path d="M10.9541 3.45557L6.00455 3.49545L5.99226 5.02155L10.5927 4.98503L3.05492 12.5549L4.12551 13.6255L11.6959 6.02298L11.6583 10.6887L13.1844 10.6764L13.2249 5.72629C13.2282 5.11964 12.9913 4.5402 12.5657 4.11468C12.1402 3.68916 11.5608 3.45218 10.9541 3.45557Z" fill="currentColor"></path></g><defs><clippath id="clip0_6401_1558"><rect width="16" height="16" fill="currentColor" transform="translate(0 0.5)"></rect></clippath></defs></svg></div></div><div class="home-products_image-wrap"><img src="/images/skyrule-svc-visa.jpg" loading="lazy" alt="Passport cover with visa stamps beside a compass on a world map" class="home-products_image"/><div class="home-products_image-overlay"></div></div></a>
    <a data-theme="dark" href="/contact" class="home-products_card w-inline-block"><div class="home-products_content-top"><div class="home-products_text-wrap"><div class="home-products_header-wrap"><h2 class="home-product_header">Airport Pick-up</h2></div><div class="home-products_body-wrap"><div class="text-size-regular">Land and go — a reliable driver waiting at arrivals, at home or abroad, whatever time you touch down.</div></div></div><div class="home-products_icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 17" fill="none"><g clip-path="url(#clip0_6401_1558)"><path d="M10.9541 3.45557L6.00455 3.49545L5.99226 5.02155L10.5927 4.98503L3.05492 12.5549L4.12551 13.6255L11.6959 6.02298L11.6583 10.6887L13.1844 10.6764L13.2249 5.72629C13.2282 5.11964 12.9913 4.5402 12.5657 4.11468C12.1402 3.68916 11.5608 3.45218 10.9541 3.45557Z" fill="currentColor"></path></g><defs><clippath id="clip0_6401_1558"><rect width="16" height="16" fill="currentColor" transform="translate(0 0.5)"></rect></clippath></defs></svg></div></div><div class="home-products_image-wrap"><img src="/images/skyrule-svc-pickup.jpg" loading="lazy" alt="A chauffeur holding an umbrella while opening a car door" class="home-products_image"/><div class="home-products_image-overlay"></div></div></a>
    <a data-theme="dark" href="/contact" class="home-products_card w-inline-block"><div class="home-products_content-top"><div class="home-products_text-wrap"><div class="home-products_header-wrap"><h2 class="home-product_header">Corporate Travel</h2></div><div class="home-products_body-wrap"><div class="text-size-regular">Travel management for businesses — policy-friendly bookings, consolidated billing and support your team can call.</div></div></div><div class="home-products_icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 17" fill="none"><g clip-path="url(#clip0_6401_1558)"><path d="M10.9541 3.45557L6.00455 3.49545L5.99226 5.02155L10.5927 4.98503L3.05492 12.5549L4.12551 13.6255L11.6959 6.02298L11.6583 10.6887L13.1844 10.6764L13.2249 5.72629C13.2282 5.11964 12.9913 4.5402 12.5657 4.11468C12.1402 3.68916 11.5608 3.45218 10.9541 3.45557Z" fill="currentColor"></path></g><defs><clippath id="clip0_6401_1558"><rect width="16" height="16" fill="currentColor" transform="translate(0 0.5)"></rect></clippath></defs></svg></div></div><div class="home-products_image-wrap"><img src="/images/skyrule-corporate-travel.jpg" loading="lazy" alt="A business traveller walking through an airport with a suitcase" class="home-products_image"/><div class="home-products_image-overlay"></div></div></a>
    <a data-theme="dark" href="/contact" class="home-products_card w-inline-block"><div class="home-products_content-top"><div class="home-products_text-wrap"><div class="home-products_header-wrap"><h2 class="home-product_header">Leisure Packages</h2></div><div class="home-products_body-wrap"><div class="text-size-regular">Honeymoons, pilgrimages, destination weddings and group getaways — affordable packages planned end to end.</div></div></div><div class="home-products_icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 17" fill="none"><g clip-path="url(#clip0_6401_1558)"><path d="M10.9541 3.45557L6.00455 3.49545L5.99226 5.02155L10.5927 4.98503L3.05492 12.5549L4.12551 13.6255L11.6959 6.02298L11.6583 10.6887L13.1844 10.6764L13.2249 5.72629C13.2282 5.11964 12.9913 4.5402 12.5657 4.11468C12.1402 3.68916 11.5608 3.45218 10.9541 3.45557Z" fill="currentColor"></path></g><defs><clippath id="clip0_6401_1558"><rect width="16" height="16" fill="currentColor" transform="translate(0 0.5)"></rect></clippath></defs></svg></div></div><div class="home-products_image-wrap"><img src="/images/skyrule-svc-leisure.jpg" loading="lazy" alt="A family on a tropical beach at sunset" class="home-products_image"/><div class="home-products_image-overlay"></div></div></a>
    <a data-theme="dark" href="/contact" class="home-products_card w-inline-block"><div class="home-products_content-top"><div class="home-products_text-wrap"><div class="home-products_header-wrap"><h2 class="home-product_header">Flight Charter</h2></div><div class="home-products_body-wrap"><div class="text-size-regular">Private jets and helicopters, short or long haul — executive meetings, private vacations, exclusive events.</div></div></div><div class="home-products_icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 17" fill="none"><g clip-path="url(#clip0_6401_1558)"><path d="M10.9541 3.45557L6.00455 3.49545L5.99226 5.02155L10.5927 4.98503L3.05492 12.5549L4.12551 13.6255L11.6959 6.02298L11.6583 10.6887L13.1844 10.6764L13.2249 5.72629C13.2282 5.11964 12.9913 4.5402 12.5657 4.11468C12.1402 3.68916 11.5608 3.45218 10.9541 3.45557Z" fill="currentColor"></path></g><defs><clippath id="clip0_6401_1558"><rect width="16" height="16" fill="currentColor" transform="translate(0 0.5)"></rect></clippath></defs></svg></div></div><div class="home-products_image-wrap"><img src="/images/skyrule-svc-charter.jpg" loading="lazy" alt="A private jet on the tarmac at sunset" class="home-products_image"/><div class="home-products_image-overlay"></div></div></a>
    <a data-theme="dark" href="/contact" class="home-products_card w-inline-block"><div class="home-products_content-top"><div class="home-products_text-wrap"><div class="home-products_header-wrap"><h2 class="home-product_header">Protocol &amp; Security</h2></div><div class="home-products_body-wrap"><div class="text-size-regular">Tailored protocol and local security arrangements — a smooth, secure passage for executives and VIPs.</div></div></div><div class="home-products_icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 17" fill="none"><g clip-path="url(#clip0_6401_1558)"><path d="M10.9541 3.45557L6.00455 3.49545L5.99226 5.02155L10.5927 4.98503L3.05492 12.5549L4.12551 13.6255L11.6959 6.02298L11.6583 10.6887L13.1844 10.6764L13.2249 5.72629C13.2282 5.11964 12.9913 4.5402 12.5657 4.11468C12.1402 3.68916 11.5608 3.45218 10.9541 3.45557Z" fill="currentColor"></path></g><defs><clippath id="clip0_6401_1558"><rect width="16" height="16" fill="currentColor" transform="translate(0 0.5)"></rect></clippath></defs></svg></div></div><div class="home-products_image-wrap"><img src="/images/skyrule-svc-protocol.jpg" loading="lazy" alt="An executive working on a laptop in the back seat of a car" class="home-products_image"/><div class="home-products_image-overlay"></div></div></a>
    <a data-theme="dark" href="/contact" class="home-products_card w-inline-block"><div class="home-products_content-top"><div class="home-products_text-wrap"><div class="home-products_header-wrap"><h2 class="home-product_header">Travel Insurance</h2></div><div class="home-products_body-wrap"><div class="text-size-regular">Cover for medical emergencies, cancellations and baggage — peace of mind built into every journey.</div></div></div><div class="home-products_icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 17" fill="none"><g clip-path="url(#clip0_6401_1558)"><path d="M10.9541 3.45557L6.00455 3.49545L5.99226 5.02155L10.5927 4.98503L3.05492 12.5549L4.12551 13.6255L11.6959 6.02298L11.6583 10.6887L13.1844 10.6764L13.2249 5.72629C13.2282 5.11964 12.9913 4.5402 12.5657 4.11468C12.1402 3.68916 11.5608 3.45218 10.9541 3.45557Z" fill="currentColor"></path></g><defs><clippath id="clip0_6401_1558"><rect width="16" height="16" fill="currentColor" transform="translate(0 0.5)"></rect></clippath></defs></svg></div></div><div class="home-products_image-wrap"><img src="/images/skyrule-svc-insurance.jpg" loading="lazy" alt="A phone showing an active travel plan resting on a passport and suitcase" class="home-products_image"/><div class="home-products_image-overlay"></div></div></a>
    <a data-theme="dark" href="/contact" class="home-products_card w-inline-block"><div class="home-products_content-top"><div class="home-products_text-wrap"><div class="home-products_header-wrap"><h2 class="home-product_header">Proof of Funds</h2></div><div class="home-products_body-wrap"><div class="text-size-regular">Support with the financial requirements of studying or relocating abroad, at competitive rates.</div></div></div><div class="home-products_icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 17" fill="none"><g clip-path="url(#clip0_6401_1558)"><path d="M10.9541 3.45557L6.00455 3.49545L5.99226 5.02155L10.5927 4.98503L3.05492 12.5549L4.12551 13.6255L11.6959 6.02298L11.6583 10.6887L13.1844 10.6764L13.2249 5.72629C13.2282 5.11964 12.9913 4.5402 12.5657 4.11468C12.1402 3.68916 11.5608 3.45218 10.9541 3.45557Z" fill="currentColor"></path></g><defs><clippath id="clip0_6401_1558"><rect width="16" height="16" fill="currentColor" transform="translate(0 0.5)"></rect></clippath></defs></svg></div></div><div class="home-products_image-wrap"><img src="/images/skyrule-svc-funds.jpg" loading="lazy" alt="A smiling graduate in cap and gown" class="home-products_image"/><div class="home-products_image-overlay"></div></div></a>
  </div></div></div></section>
  <header data-theme="dark" class="section_build-cta"><div class="padding-global"><div class="container-large"><div class="padding-section-large"><div class="build-cta_component"><div class="build-cta_header-wrap"><div data-wf--header-block--size="medium---centre" class="header-wrapper w-variant-ad828f27-e9ee-986a-b474-73e7a657278c"><div class="header-text-wrap"><div class="header-top"><h2 class="heading-style w-variant-ad828f27-e9ee-986a-b474-73e7a657278c">Not sure what you need?</h2></div><p class="body-text">Tell us where you're going and we'll come back with options and a clear quote — within one business day.</p></div><div class="button-group"><Button href="/contact" label="Get in touch" icon={false} /></div></div></div></div></div></div></div></header>
</BaseLayout>
