<script is:inline>
// GSAP Parallax (ported from benchmark's code-embed-js)
document.addEventListener("DOMContentLoaded", () => {
  gsap.registerPlugin(ScrollTrigger);

  const initParallax = () => {
    document.querySelectorAll("[data-parallax-layers]").forEach((triggerElement) => {
      let tl = gsap.timeline({
        scrollTrigger: {
          trigger: triggerElement,
          start: "0% 0%",
          end: "100% 0%",
          scrub: 0
        }
      });

      const layers = [
        { layer: "1", yPercent: 40 },
        { layer: "2", yPercent: 30 },
        { layer: "3", yPercent: 80 },
        { layer: "4", yPercent: 20 }
      ];

      layers.forEach((layerObj, idx) => {
        tl.to(
          triggerElement.querySelectorAll(`[data-parallax-layer="${layerObj.layer}"]`),
          { yPercent: layerObj.yPercent, ease: "none" },
          idx === 0 ? undefined : "<"
        );
      });
    });
  };

  const checkBreakpoint = () => {
    if (window.innerWidth > 991) {
      initParallax();
    } else {
      ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
    }
  };

  checkBreakpoint();
  window.addEventListener("resize", checkBreakpoint);
});

// Swiper (ported from benchmark's product-benefits_js embed)
document.addEventListener("DOMContentLoaded", () => {
  document.querySelectorAll(".product-benefits_wrap").forEach((wrap) => {
    if (wrap.dataset.scriptInitialized) return;
    wrap.dataset.scriptInitialized = "true";

    const cmsWrap = wrap.querySelector(".product-benefits_cms_wrap");
    if (!cmsWrap || typeof Swiper === "undefined") return;

    new Swiper(cmsWrap, {
      slidesPerView: "auto",
      followFinger: true,
      freeMode: false,
      slideToClickedSlide: false,
      centeredSlides: false,
      autoHeight: false,
      speed: 600,
      mousewheel: { forceToAxis: true },
      keyboard: { enabled: true, onlyInViewport: true },
      navigation: {
        nextEl: wrap.querySelector(".product-benefits_btn_element.is-next"),
        prevEl: wrap.querySelector(".product-benefits_btn_element.is-prev"),
      },
      pagination: {
        el: wrap.querySelector(".product-benefits_bullet_wrap"),
        bulletActiveClass: "is-active",
        bulletClass: "product-benefits_bullet_item",
        bulletElement: "button",
        clickable: true,
      },
      scrollbar: {
        el: wrap.querySelector(".product-benefits_draggable_wrap"),
        draggable: true,
        dragClass: "product-benefits_draggable_handle",
        snapOnRelease: true,
      },
      slideActiveClass: "is-active",
      slideDuplicateActiveClass: "is-active",
    });
  });
});

// Contact avatar open/closed status dot (ported from benchmark)
document.addEventListener("DOMContentLoaded", () => {
  const openingHours = {
    monday: { open: "08:30", close: "17:00" },
    tuesday: { open: "08:30", close: "17:00" },
    wednesday: { open: "08:30", close: "17:00" },
    thursday: { open: "08:30", close: "17:00" },
    friday: { open: "08:30", close: "16:00" },
    saturday: null,
    sunday: null,
  };
  const openColor = "#00cc41";
  const closedColor = "#fd1d0c";

  const now = new Date();
  const options = { timeZone: "Europe/London", hour12: false, weekday: "long", hour: "2-digit", minute: "2-digit" };
  const formattedTime = new Intl.DateTimeFormat("en-GB", options).formatToParts(now);
  const currentDay = formattedTime.find(part => part.type === "weekday").value.toLowerCase();
  const currentHour = formattedTime.find(part => part.type === "hour").value;
  const currentMinute = formattedTime.find(part => part.type === "minute").value;
  const currentTime = `${currentHour}:${currentMinute}`;

  function isOpen(day, time) {
    const hours = openingHours[day];
    if (!hours) return false;
    return time >= hours.open && time <= hours.close;
  }

  const dot = document.querySelector(".contact-cta_avatar-dot");
  if (dot) {
    dot.style.backgroundColor = isOpen(currentDay, currentTime) ? openColor : closedColor;
  }
});

// Video lightbox (hero + home-video "Watch Video" triggers)
function getYouTubeId(url) {
  const match = url.match(/(?:v=|youtu\.be\/)([\w-]{11})/);
  return match ? match[1] : null;
}

function openVideoLightbox(url) {
  const videoId = getYouTubeId(url);
  if (!videoId) return;

  const overlay = document.createElement("div");
  overlay.className = "video-lightbox-overlay";
  overlay.style.cssText = "position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.85);display:flex;align-items:center;justify-content:center;padding:2rem;";

  const iframeWrap = document.createElement("div");
  iframeWrap.style.cssText = "position:relative;width:100%;max-width:960px;aspect-ratio:16/9;";
  const iframe = document.createElement("iframe");
  iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
  iframe.title = "YouTube video player";
  iframe.style.cssText = "width:100%;height:100%;border:0;";
  iframe.allow = "autoplay; encrypted-media; picture-in-picture";
  iframe.allowFullscreen = true;
  iframeWrap.appendChild(iframe);

  overlay.appendChild(iframeWrap);
  document.body.appendChild(overlay);

  function closeLightbox() {
    overlay.remove();
    document.removeEventListener("keydown", onKeydown);
  }
  function onKeydown(e) {
    if (e.key === "Escape") closeLightbox();
  }
  overlay.addEventListener("click", (e) => {
    if (e.target === overlay) closeLightbox();
  });
  document.addEventListener("keydown", onKeydown);
}

document.querySelectorAll("[data-video-url]").forEach((trigger) => {
  trigger.addEventListener("click", (e) => {
    e.preventDefault();
    openVideoLightbox(trigger.getAttribute("data-video-url"));
  });
});
</script>
