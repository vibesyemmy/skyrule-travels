---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/button/Button.astro";
---
<BaseLayout navbarStartScrolled>
  <!-- Page background: the fixed footer sits behind the content sheet (reveal effect);
       homepage sections each paint their own background, this page's light
       sections don't — so paint the sheet white here. Ships on /about only.
       (The statement band below paints its own dark background.) -->
  <style is:global>.scroll-wrapper { background-color: var(--background-color--background-primary); }</style>
  <section class="padding-global"><div class="container-large"><div class="padding-section-large">
    <h1 class="heading-style-h1">About Skyrule</h1>
    <p class="body-text">The Lagos travel agency that plans your trip from start to finish — so all you do is travel.</p>
  </div></div></section>
  <section data-theme="light" class="section_fitter-cta"><div class="padding-global"><div class="container-large"><div class="padding-section-large"><div class="fitter-cta_component"><div class="fitter-cta_image-wrap"><img src="images/skyrule-about-travel.jpg" loading="lazy" alt="A smiling traveller holding her passport and tickets beside her suitcase" class="fitter-cta_image"/></div><div class="fitter-cta_content"><div class="header-wrapper"><div class="header-text-wrap"><div class="header-top"><h2 class="heading-style w-variant-87a93e56-e06c-9aaf-6ae7-13e106677c9c">Travel, made personal</h2></div><p class="body-text">Skyrule Travels is a travel agency based in Lekki, Lagos. We plan trips from start to finish — flights, hotels, visa assistance and airport pick-ups — for individuals, families and businesses, local and international. Every itinerary is put together by a travel expert who works with your plans and your budget, and stays with you until you're home again.</p></div><div class="button-group"><Button href="/contact" label="Plan your trip" /></div></div></div></div></div></div></div></section>
  <header data-theme="dark" class="section_build-cta"><div class="padding-global"><div class="container-large"><div class="padding-section-large"><div class="build-cta_component"><div class="build-cta_header-wrap"><div data-wf--header-block--size="medium---centre" class="header-wrapper w-variant-ad828f27-e9ee-986a-b474-73e7a657278c"><div class="header-text-wrap"><div class="header-top"><h2 class="heading-style w-variant-ad828f27-e9ee-986a-b474-73e7a657278c">Travel enriches the mind, body and soul</h2></div><p class="body-text">That belief is why Skyrule exists — and why we sweat every detail of every trip, from fare rules to visa timelines to the pick-up waiting at arrivals. You focus on the going; we handle everything else.</p></div><div class="button-group"><Button href="/contact" label="Get in touch" icon={false} /></div></div></div></div></div></div></div></header>
</BaseLayout>
