---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/button/Button.astro";
---
<BaseLayout navbarStartScrolled>
  <!-- Page background: the fixed footer sits behind the content sheet (reveal effect);
       homepage sections each paint their own background, this page's placeholder
       sections don't — so paint the sheet white here. Ships on /about only. -->
  <style is:global>.scroll-wrapper { background-color: var(--background-color--background-primary); }</style>
  <section class="padding-global"><div class="container-large"><div class="padding-section-large">
    <h1 class="heading-style-h1">About</h1>
    <p class="body-text">Coming soon.</p>
  </div></div></section>
  <section data-theme="light" class="section_fitter-cta"><div class="padding-global"><div class="container-large"><div class="padding-section-large"><div class="fitter-cta_component"><div class="fitter-cta_image-wrap"><img src="images/677bada9a60712078792c17b_About Home - Image.webp" loading="lazy" alt="" class="fitter-cta_image"/></div><div class="fitter-cta_content"><div class="header-wrapper"><div class="header-text-wrap"><div class="header-top"><h1 class="heading-style w-variant-87a93e56-e06c-9aaf-6ae7-13e106677c9c">Built by enthusiasts, for enthusiasts</h1></div><p class="body-text">Placeholder copy — for three decades we’ve designed, tested, and hand-built elevating roofs in our UK workshop. This block previews how a text and image section sits on the About page.</p></div><div class="button-group"><Button href="/contact" label="Get in touch" /></div></div></div></div></div></div></div></section>
</BaseLayout>
