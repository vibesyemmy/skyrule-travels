---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/button/Button.astro";
---
<BaseLayout navbarStartScrolled>
  <!-- Page background: the fixed footer sits behind the content sheet (reveal effect);
       homepage sections each paint their own background, this page's light
       sections don't — so paint the sheet white here. Ships on /about only.
       (The statement band below paints its own dark background.) -->
  <style is:global>.scroll-wrapper { background-color: var(--background-color--background-primary); }</style>
  <section class="padding-global"><div class="container-large"><div class="padding-section-large">
    <h1 class="heading-style-h1">About Skyrule</h1>
    <p class="body-text">The Lagos travel agency that plans your trip from start to finish — so all you do is travel.</p>
  </div></div></section>
  <section data-theme="light" class="section_fitter-cta"><div class="padding-global"><div class="container-large"><div class="padding-section-large"><div class="fitter-cta_component"><div class="fitter-cta_image-wrap"><img src="images/skyrule-about-travel.jpg" loading="lazy" alt="Two travellers in a sunny city square, consulting a map with backpacks on" class="fitter-cta_image"/></div><div class="fitter-cta_content"><div class="header-wrapper"><div class="header-text-wrap"><div class="header-top"><h2 class="heading-style w-variant-87a93e56-e06c-9aaf-6ae7-13e106677c9c">Travel, made personal</h2></div><p class="body-text">Skyrule Travels is a travel management company based in Lekki, Lagos — established in August 2016, fully registered and IATA-accredited. We plan trips from start to finish — flights, hotels, visa assistance and airport pick-ups — for individuals, families and businesses, local and international. Every itinerary is put together by a travel expert who works with your plans and your budget, and stays with you until you're home again.</p></div><div class="button-group"><Button href="/contact" label="Plan your trip" /></div></div></div></div></div></div></div></section>
    <!-- Accreditations & partners — logos extracted from the client's company
       profile PDF (placeholder quality; client to supply high-res versions,
       same filenames swap in place under public/images/logos/). -->
  <style>
    .logo-strip { display: flex; flex-direction: column; gap: 3rem; }
    .logo-strip_group { display: flex; flex-direction: column; gap: 1.25rem; }
    .logo-strip_row { display: flex; flex-wrap: wrap; align-items: center; column-gap: 2.5rem; row-gap: 1.5rem; }
    .logo-strip_row img { height: 2rem; width: auto; filter: grayscale(1); opacity: 0.7; }
    .logo-strip_row.is-accred img { height: 3.25rem; filter: none; opacity: 1; }
  </style>
  <section class="padding-global"><div class="container-large"><div class="padding-section-large no-padding-top"><div class="logo-strip">
    <div class="logo-strip_group"><h3 class="heading-style-h6">Our accreditations</h3><div class="logo-strip_row is-accred"><img src="/images/logos/accred-iata.png" loading="lazy" alt="IATA Accredited Agent"/><img src="/images/logos/accred-nanta.png" loading="lazy" alt="NANTA — National Association of Nigeria Travel Agencies"/><img src="/images/logos/accred-nuprc.png" loading="lazy" alt="NUPRC"/><img src="/images/logos/accred-ncaa.png" loading="lazy" alt="Nigerian Civil Aviation Authority"/><img src="/images/logos/accred-amadeus.png" loading="lazy" alt="Amadeus"/></div></div>
    <div class="logo-strip_group"><h3 class="heading-style-h6">Partner airlines</h3><div class="logo-strip_row"><img src="/images/logos/airline-delta.png" loading="lazy" alt="Delta Air Lines"/><img src="/images/logos/airline-lufthansa.png" loading="lazy" alt="Lufthansa"/><img src="/images/logos/airline-arik.png" loading="lazy" alt="Arik Air"/><img src="/images/logos/airline-british-airways.png" loading="lazy" alt="British Airways"/><img src="/images/logos/airline-egyptair.png" loading="lazy" alt="EgyptAir"/><img src="/images/logos/airline-virgin-atlantic.png" loading="lazy" alt="Virgin Atlantic"/><img src="/images/logos/airline-asky.png" loading="lazy" alt="ASKY Airlines"/><img src="/images/logos/airline-camair-co.png" loading="lazy" alt="Camair-Co"/><img src="/images/logos/airline-royal-air-maroc.png" loading="lazy" alt="Royal Air Maroc"/><img src="/images/logos/airline-united.png" loading="lazy" alt="United Airlines"/><img src="/images/logos/airline-air-france.png" loading="lazy" alt="Air France"/><img src="/images/logos/airline-alitalia.png" loading="lazy" alt="Alitalia"/><img src="/images/logos/airline-gambia-bird.png" loading="lazy" alt="Gambia Bird"/><img src="/images/logos/airline-south-african.png" loading="lazy" alt="South African Airways"/><img src="/images/logos/airline-hahn-air.png" loading="lazy" alt="Hahn Air"/><img src="/images/logos/airline-turkish.png" loading="lazy" alt="Turkish Airlines"/><img src="/images/logos/airline-air-senegal.png" loading="lazy" alt="Air Senegal"/><img src="/images/logos/airline-ethiopian.png" loading="lazy" alt="Ethiopian Airlines"/><img src="/images/logos/airline-etihad.png" loading="lazy" alt="Etihad Airways"/><img src="/images/logos/airline-kenya-airways.png" loading="lazy" alt="Kenya Airways"/><img src="/images/logos/airline-klm.png" loading="lazy" alt="KLM"/><img src="/images/logos/airline-qatar.png" loading="lazy" alt="Qatar Airways"/><img src="/images/logos/airline-rwandair.png" loading="lazy" alt="RwandAir"/><img src="/images/logos/airline-china-southern.png" loading="lazy" alt="China Southern"/><img src="/images/logos/airline-iberia.png" loading="lazy" alt="Iberia"/></div></div>
    <div class="logo-strip_group"><h3 class="heading-style-h6">Clients we serve</h3><div class="logo-strip_row"><img src="/images/logos/client-genesis-energy.png" loading="lazy" alt="Genesis Energy"/><img src="/images/logos/client-palton-morgan.png" loading="lazy" alt="Palton Morgan Holdings"/><img src="/images/logos/client-iesl.png" loading="lazy" alt="International Energy Services Limited"/><img src="/images/logos/client-university.png" loading="lazy" alt="University client"/><img src="/images/logos/client-sci-altar.png" loading="lazy" alt="SCI Altar Energy"/><img src="/images/logos/client-propertymart.png" loading="lazy" alt="Propertymart"/><img src="/images/logos/client-jamb.png" loading="lazy" alt="JAMB"/><img src="/images/logos/client-dfc.png" loading="lazy" alt="DFC Holdings"/></div></div>
    <div class="logo-strip_group"><h3 class="heading-style-h6">Our bankers</h3><div class="logo-strip_row"><img src="/images/logos/bank-stanbic-ibtc.png" loading="lazy" alt="Stanbic IBTC"/><img src="/images/logos/bank-providus.png" loading="lazy" alt="Providus Bank"/><img src="/images/logos/bank-access.png" loading="lazy" alt="Access Bank"/></div></div>
  </div></div></div></section>
  <section data-theme="dark" class="section_home-about"><div class="padding-global"><div class="container-large"><div class="padding-section-large"><div class="home-about_component"><div class="home-about_top"><div class="header-eyebrow-text">Why Skyrule</div><h2 class="home-about_heading">Unparalleled service and personalised attention — <span class="text-span-white">from corporate travel management to leisure travel planning.</span></h2></div><div class="home-about_bottom"><div class="home-about_left"><div class="home-about_image-wrap"><img src="/images/skyrule-lagos-aerial.jpg" loading="lazy" alt="Aerial view of Lagos cityscape with coastal waters on the horizon" class="home-about_image"/></div><div class="button-group"><Button href="/contact" label="Start planning" variant="brand" /></div></div><div class="home-about_list"><div class="home-about_list-item"><div class="home-about_icon-wrap"><div class="icon-embed-xxsmall w-embed"><svg width="100%" height="100%" viewBox="0 0 16 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16 4.45718C16 5.38937 15.6647 6.40751 15.004 7.4836C14.9413 7.58485 14.83 7.64088 14.716 7.64088C14.658 7.64088 14.6 7.62687 14.5473 7.59694C14.3887 7.5078 14.3353 7.31296 14.428 7.16141C15.028 6.18402 15.3327 5.27475 15.3327 4.45718C15.3327 2.45782 13.5853 0.63674 11.666 0.63674C10.0967 0.63674 9.29333 1.227 8.544 1.88411L5.68333 4.58898C5.29067 4.96402 5.21733 5.54473 5.51467 5.93887C5.70333 6.18911 5.98067 6.34002 6.296 6.36422C6.60667 6.3865 6.912 6.28144 7.132 6.07131L10.0987 3.27603C10.2293 3.1525 10.4413 3.15377 10.57 3.27921C10.6993 3.40401 10.698 3.60586 10.5673 3.72939L9.61 4.63165L13.1547 7.60331C13.7973 8.14136 13.9587 9.04043 13.53 9.695C13.266 10.0987 12.834 10.3699 12.3467 10.4381C12.19 10.4604 12.032 10.4616 11.8773 10.4406C11.964 10.8329 11.902 11.2467 11.676 11.5925C11.4113 11.9968 10.9793 12.2674 10.492 12.3356C10.2607 12.368 10.0293 12.354 9.81067 12.2967C9.83733 12.624 9.76333 12.9551 9.576 13.2397C9.312 13.64