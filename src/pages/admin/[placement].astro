---
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";
import { promoStore } from "../../lib/promos/store";
import { utcIsoToWatLocal } from "../../lib/promos/datetime";
import { PLACEMENTS, type Placement } from "../../lib/promos/schema";

const placement = Astro.params.placement as Placement;
if (!PLACEMENTS.includes(placement)) return Astro.redirect("/admin");

const { promos } = await promoStore.read();
const promo = promos.find((p) => p.placement === placement) ?? null;
---
<AdminLayout title="Edit promo">
  <a href="/admin" class="text-sm text-neutral-400 underline">Back</a>
  <h1 class="text-2xl font-semibold mt-2 mb-6">Edit {placement} promo</h1>

  <form id="promo-form" class="space-y-5" data-placement={placement} data-id={promo?.id ?? ""}>
    <label class="flex items-center gap-2">
      <input type="checkbox" name="enabled" checked={promo?.enabled ?? false} />
      <span>Enabled — show this promo on the site, subject to any schedule below</span>
    </label>

    <div>
      <label class="block text-sm mb-1" for="eyebrow">Eyebrow (optional)</label>
      <input id="eyebrow" name="eyebrow" value={promo?.eyebrow ?? ""}
             class="w-full rounded-md bg-neutral-900 border border-neutral-700 px-3 py-2" />
    </div>

    <div>
      <label class="block text-sm mb-1" for="headline">Headline</label>
      <input id="headline" name="headline" required value={promo?.headline ?? ""}
             class="w-full rounded-md bg-neutral-900 border border-neutral-700 px-3 py-2" />
    </div>

    <div class="grid md:grid-cols-2 gap-3">
      <div>
        <label class="block text-sm mb-1" for="body">Body (markdown)</label>
        <textarea id="body" name="body" rows="8"
                  class="w-full rounded-md bg-neutral-900 border border-neutral-700 px-3 py-2 font-mono text-sm">{promo?.body ?? ""}</textarea>
        <p class="text-xs text-neutral-500 mt-1">Bold, italic, links and lists. Headings are stripped.</p>
      </div>
      <div>
        <span class="block text-sm mb-1">Preview</span>
        <div id="preview" class="promo-preview rounded-md border border-neutral-800 p-3 min-h-[8rem] text-sm"></div>
      </div>
    </div>

    <fieldset class="border border-neutral-800 rounded-md p-4 space-y-3">
      <legend class="text-sm px-1">Image</legend>

      <div id="dropzone" role="button" tabindex="0"
           aria-label="Add an image"
           aria-describedby="dropzone-hint"
           class="rounded-lg border-2 border-dashed border-neutral-700 bg-neutral-900/40 px-4 py-6 cursor-pointer transition-colors hover:border-neutral-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lime-400">

        <div id="dropzone-empty" class="flex flex-col items-center gap-2 text-center" hidden={Boolean(promo?.image)}>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8 text-neutral-500">
            <path d="M12 16V4m0 0L8 8m4-4 4 4" />
            <path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" />
          </svg>
          <p class="text-sm">
            <span class="font-medium text-lime-400 underline">Choose an image</span><span class="text-neutral-400"> or drag one here</span>
          </p>
          <p id="dropzone-hint" class="text-xs text-neutral-500">JPEG, PNG or WebP, up to 5MB. You can also paste one.</p>
        </div>

        <div id="dropzone-filled" class="flex flex-col sm:flex-row items-center gap-4 text-left" hidden={!promo?.image}>
          <img id="image-preview" src={promo?.image?.url ?? ""} alt=""
               class="h-20 w-20 shrink-0 rounded object-cover bg-neutral-800" />
          <div class="min-w-0 flex-1">
            <p id="image-name" class="truncate text-sm">Current image</p>
            <p id="image-meta" class="text-xs text-neutral-500">
              {promo?.image ? `${promo.image.width} x ${promo.image.height}` : ""}
            </p>
          </div>
          <div class="flex gap-2">
            <button type="button" id="image-replace"
                    class="rounded-md border border-neutral-700 px-3 py-1.5 text-sm hover:border-neutral-500">Replace</button>
            <button type="button" id="image-remove"
                    class="rounded-md border border-neutral-700 px-3 py-1.5 text-sm text-red-300 hover:border-red-400">Remove</button>
          </div>
        </div>

        <p id="dropzone-uploading" class="text-center text-sm text-neutral-300" hidden>Uploading…</p>
      </div>

      <input type="file" id="file" accept="image/jpeg,image/png,image/webp" class="sr-only" tabindex="-1" />
      <p id="upload-error" role="alert" class="text-sm text-red-400" hidden></p>
      <div>
        <label class="block text-sm mb-1" for="alt">Alt text (required with an image)</label>
        <input id="alt" name="alt" value={promo?.image?.alt ?? ""}
               class="w-full rounded-md bg-neutral-900 border border-neutral-700 px-3 py-2" />
      </div>
      <input type="hidden" id="image-url" value={promo?.image?.url ?? ""} />
      <input type="hidden" id="image-width" value={promo?.image?.width ?? ""} />
      <input type="hidden" id="image-height" value={promo?.image?.height ?? ""} />
    </fieldset>

    <fieldset class="border border-neutral-800 rounded-md p-4 grid md:grid-cols-2 gap-3">
      <legend class="text-sm px-1">Call to action (optional)</legend>
      <div>
        <label class="block text-sm mb-1" for="cta-label">Button label</label>
        <input id="cta-label" value={promo?.cta?.label ?? ""}
               class="w-full rounded-md bg-neutral-900 border border-neutral-700 px-3 py-2" />
      </div>
      <div>
        <label class="block text-sm mb-1" for="cta-href">Link</label>
        <input id="cta-href" value={promo?.cta?.href ?? ""} placeholder="/contact"
               class="w-full rounded-md bg-neutral-900 border border-neutral-700 px-3 py-2" />
      </div>
    </fieldset>

    <fieldset class="border border-neutral-800 rounded-md p-4 grid md:grid-cols-2 gap-3">
      <legend class="text-sm px-1">Schedule — times are West Africa Time</legend>
      <div>
        <label class="block text-sm mb-1" for="startsAt">Starts (blank = immediately)</label>
        <input id="startsAt" type="datetime-local" value={utcIsoToWatLocal(promo?.startsAt ?? null)}
               class="w-full rounded-md bg-neutral-900 border border-neutral-700 px-3 py-2" />
      </div>
      <div>
        <label class="block text-sm mb-1" for="endsAt">Ends (blank = never)</label>
        <input id="endsAt" type="datetime-local" value={utcIsoToWatLocal(promo?.endsAt ?? null)}
               class="w-full rounded-md bg-neutral-900 border border-neutral-700 px-3 py-2" />
      </div>
    </fieldset>

    <p id="form-error" class="text-sm text-red-400 hidden"></p>
    <p id="form-saved" class="text-sm text-lime-400 hidden">Saved.</p>

    <div class="flex gap-3">
      <button type="submit" class="rounded-md bg-lime-400 text-neutral-900 font-medium px-4 py-2">Save</button>
      <button type="button" id="clear" class="rounded-md border border-neutral-700 px-4 py-2">Delete promo</button>
    </div>
  </form>
</AdminLayout>

<style>
  /* Tailwind's flex utility would otherwise override [hidden]'s display:none. */
  #dropzone-empty[hidden],
  #dropzone-filled[hidden],
  #dropzone-uploading[hidden],
  #upload-error[hidden] { display: none; }

  #dropzone.is-dragging {
    border-color: #a3d346;
    background-color: rgba(163, 211, 70, 0.08);
  }
</style>

<style>
  /* Tailwind's preflight removes list markers and paragraph spacing, and the
     typography plugin is not installed — so the preview needs these rules to
     match what the site actually renders from the same markdown. */
  .promo-preview :global(p) { margin: 0 0 0.75em; }
  .promo-preview :global(p:last-child) { margin-bottom: 0; }
  .promo-preview :global(ul) { list-style: disc; padding-left: 1.25em; margin: 0 0 0.75em; }
  .promo-preview :global(ol) { list-style: decimal; padding-left: 1.25em; margin: 0 0 0.75em; }
  .promo-preview :global(li) { margin: 0.15em 0; }
  .promo-preview :global(a) { text-decoration: underline; }
  .promo-preview :global(strong) { font-weight: 700; }
  .promo-preview :global(em) { font-style: italic; }
</style>

<script>
  import { marked } from "marked";
  import { validateUpload } from "../../lib/promos/image";

  const form = document.getElementById("promo-form") as HTMLFormElement;
  const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
  const el = (id: string) => document.getElementById(id)!;

  // Live preview. This parser only ever runs inside the admin — the public
  // site is served pre-rendered HTML.
  const bodyField = el("body") as HTMLTextAreaElement;
  const paint = () => { el("preview").innerHTML = marked.parse(bodyField.value, { async: false }) as string; };
  bodyField.addEventListener("input", paint);
  paint();

  // Dimensions are measured here so the renderers can set width/height and
  // stop the image from shifting surrounding content as it loads.
  // ---- image drop zone -------------------------------------------------
  const dropzone = el("dropzone");
  const fileInput = el("file") as HTMLInputElement;
  const zoneEmpty = el("dropzone-empty");
  const zoneFilled = el("dropzone-filled");
  const zoneUploading = el("dropzone-uploading");
  const uploadError = el("upload-error");
  const altField = el("alt") as HTMLInputElement;

  const hasImage = () => Boolean((el("image-url") as HTMLInputElement).value);

  const formatBytes = (bytes: number) =>
    bytes >= 1024 * 1024 ? `${(bytes / (1024 * 1024)).toFixed(1)}MB` : `${Math.max(1, Math.round(bytes / 1024))}KB`;

  function render(state: "empty" | "filled" | "uploading") {
    zoneEmpty.hidden = state !== "empty";
    zoneFilled.hidden = state !== "filled";
    zoneUploading.hidden = state !== "uploading";
    // Alt text is required by the server whenever an image is set; mirroring it
    // here means the browser catches it before a round trip.
    altField.required = state === "filled";
    dropzone.setAttribute("aria-label", state === "filled" ? "Replace the image" : "Add an image");
  }

  function showError(message: string) {
    uploadError.textContent = message;
    uploadError.hidden = false;
  }

  /**
   * Read an image's pixel dimensions.
   *
   * Uses an object URL and <img> rather than createImageBitmap: the latter
   * rejects files this browser renders perfectly well (observed failing with
   * InvalidStateError on a valid PNG), which blocked the upload entirely and
   * reported a misleading "could not be read as an image". createImageBitmap
   * stays as a fallback for anything <img> cannot decode.
   */
  function measureImage(file: File): Promise<{ width: number; height: number }> {
    return new Promise((resolve, reject) => {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => {
        URL.revokeObjectURL(url);
        resolve({ width: img.naturalWidth, height: img.naturalHeight });
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        createImageBitmap(file)
          .then((bitmap) => resolve({ width: bitmap.width, height: bitmap.height }))
          .catch(reject);
      };
      img.src = url;
    });
  }

  async function handleFile(file: File) {
    uploadError.hidden = true;

    // Same rules the endpoint enforces — checked here purely for instant feedback.
    const problem = validateUpload(file.type, file.size);
    if (problem) {
      showError(problem);
      return;
    }

    render("uploading");
    try {
      const { width, height } = await measureImage(file);
      const data = new FormData();
      data.append("file", file);
      data.append("width", String(width));
      data.append("height", String(height));

      const response = await fetch("/api/admin/upload", { method: "POST", body: data });
      const result = await response.json();
      if (!result.ok) {
        showError(result.error);
        render(hasImage() ? "filled" : "empty");
        return;
      }

      (el("image-url") as HTMLInputElement).value = result.url;
      (el("image-width") as HTMLInputElement).value = String(result.width);
      (el("image-height") as HTMLInputElement).value = String(result.height);
      (el("image-preview") as HTMLImageElement).src = result.url;
      el("image-name").textContent = file.name;
      el("image-meta").textContent = `${result.width} x ${result.height} · ${formatBytes(file.size)}`;
      render("filled");
      if (!altField.value.trim()) altField.focus();
    } catch {
      showError("That file could not be read as an image. Try a different one.");
      render(hasImage() ? "filled" : "empty");
    }
  }

  const browse = () => fileInput.click();

  dropzone.addEventListener("click", (event) => {
    // The Replace/Remove buttons handle their own clicks.
    if ((event.target as HTMLElement).closest("button")) return;
    browse();
  });

  dropzone.addEventListener("keydown", (event) => {
    if (event.key === "Enter" || event.key === " ") {
      event.preventDefault();
      browse();
    }
  });

  el("image-replace").addEventListener("click", browse);

  el("image-remove").addEventListener("click", () => {
    for (const id of ["image-url", "image-width", "image-height"]) (el(id) as HTMLInputElement).value = "";
    fileInput.value = "";
    (el("image-preview") as HTMLImageElement).removeAttribute("src");
    uploadError.hidden = true;
    render("empty");
  });

  fileInput.addEventListener("change", () => {
    const file = fileInput.files?.[0];
    if (file) handleFile(file);
  });

  for (const type of ["dragenter", "dragover"]) {
    dropzone.addEventListener(type, (event) => {
      event.preventDefault();
      dropzone.classList.add("is-dragging");
    });
  }
  for (const type of ["dragleave", "dragend"]) {
    dropzone.addEventListener(type, () => dropzone.classList.remove("is-dragging"));
  }

  dropzone.addEventListener("drop", (event) => {
    event.preventDefault();
    dropzone.classList.remove("is-dragging");
    const file = (event as DragEvent).dataTransfer?.files?.[0];
    if (file) handleFile(file);
  });

  // A file dropped outside the zone would otherwise navigate away from the
  // half-filled form, losing whatever the client had typed.
  for (const type of ["dragover", "drop"]) {
    window.addEventListener(type, (event) => {
      if (!(event.target as HTMLElement)?.closest?.("#dropzone")) event.preventDefault();
    });
  }

  dropzone.addEventListener("paste", (event) => {
    const file = (event as ClipboardEvent).clipboardData?.files?.[0];
    if (file) {
      event.preventDefault();
      handleFile(file);
    }
  });

  render(hasImage() ? "filled" : "empty");

  async function send(payload: Record<string, unknown>) {
    const error = el("form-error");
    const saved = el("form-saved");
    error.classList.add("hidden");
    saved.classList.add("hidden");

    const response = await fetch("/api/admin/promo", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });
    const result = await response.json();
    if (!result.ok) {
      // The form keeps its values — a failed save must never lose typed copy.
      error.textContent = result.error;
      error.classList.remove("hidden");
      return false;
    }
    saved.classList.remove("hidden");
    return true;
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    await send({
      id: form.dataset.id,
      placement: form.dataset.placement,
      enabled: (form.elements.namedItem("enabled") as HTMLInputElement).checked,
      eyebrow: val("eyebrow"),
      headline: val("headline"),
      body: bodyField.value,
      image: val("image-url")
        ? { url: val("image-url"), alt: val("alt"), width: val("image-width"), height: val("image-height") }
        : null,
      cta: val("cta-label") || val("cta-href") ? { label: val("cta-label"), href: val("cta-href") } : null,
      startsAt: val("startsAt"),
      endsAt: val("endsAt"),
    });
  });

  el("clear").addEventListener("click", async () => {
    if (!confirm("Delete this promo? This cannot be undone.")) return;
    if (await send({ placement: form.dataset.placement, action: "clear" })) {
      window.location.href = "/admin";
    }
  });
</script>
