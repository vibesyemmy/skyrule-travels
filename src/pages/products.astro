---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = Astro.url.pathname.replace("/", "").replace(/-/g, " ") || "page";
---
<BaseLayout>
  <section class="section section-px pt-40">
    <div class="container">
      <h1 class="h1 capitalize mb-4">{title || "Page"}</h1>
      <p class="text-neutral-300 text-lg">Coming soon.</p>
    </div>
  </section>
</BaseLayout>
