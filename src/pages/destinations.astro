---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout navbarStartScrolled title="Destinations | Skyrule Travels" description="Dubai, London, Paris, New York, Santorini, Rome and beyond — flights, hotels, visas and pick-ups arranged for every trip. Don't see yours? Just ask.">
  <!-- White content sheet (same rationale as about.astro/contact.astro):
       the fixed footer sits behind the content sheet. Ships on /destinations only. -->
  <style is:global>.scroll-wrapper { background-color: var(--background-color--background-primary); }</style>
  <section class="padding-global"><div class="container-large"><div class="padding-section-large">
    <h1 class="heading-style-h1">Destinations</h1>
    <p class="body-text">A few favourites from our travellers — flights, hotels, visas and pick-ups arranged for every one of them. Don't see yours? We plan trips everywhere; just ask.</p>
  </div></div></section>
  <section class="padding-global"><div class="container-large"><div class="padding-section-large no-padding-top"><div class="home-products_component">
    <a data-theme="dark" href="/contact" class="home-products_card w-inline-block"><div class="home-products_content-top"><div class="home-products_text-wrap"><div class="home-products_header-wrap"><h2 class="home-product_header">Dubai</h2></div><div class="home-products_body-wrap"><div class="text-size-regular">Sky-high icons, desert safaris and world-class shopping — the short-haul favourite for stopovers and five-star getaways alike.</div></div></div><div class="home-products_icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 17" fill="none"><g clip-path="url(#clip0_6401_1558)"><path d="M10.9541 3.45557L6.00455 3.49545L5.99226 5.02155L10.5927 4.98503L3.05492 12.5549L4.12551 13.6255L11.6959 6.02298L11.6583 10.6887L13.1844 10.6764L13.2249 5.72629C13.2282 5.11964 12.9913 4.5402 12.5657 4.11468C12.1402 3.68916 11.5608 3.45218 10.9541 3.45557Z" fill="currentColor"></path></g><defs><clippath id="clip0_6401_1558"><rect width="16" height="16" fill="currentColor" transform="translate(0 0.5)"></rect></clippath></defs></svg></div></div><div class="home-products_image-wrap"><img src="/images/skyrule-dest-dubai.jpg" loading="lazy" alt="Burj Khalifa rising over downtown Dubai on a clear day" class="home-products_image"/><div class="home-products_image-overlay"></div></div></a>
    <a data-theme="dark" href="/contact" class="home-products_card w-inline-block"><div class="home-products_content-top"><div class="home-products_text-wrap"><div class="home-products_header-wrap"><h2 class="home-product_header">London</h2></div><div class="home-products_body-wrap"><div class="text-size-regular">Museums and markets, royal landmarks and West End nights — the classic city break for every season.</div></div></div><div class="home-products_icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 17" fill="none"><g clip-path="url(#clip0_6401_1558)"><path d="M10.9541 3.45557L6.00455 3.49545L5.99226 5.02155L10.5927 4.98503L3.05492 12.5549L4.12551 13.6255L11.6959 6.02298L11.6583 10.6887L13.1844 10.6764L13.2249 5.72629C13.2282 5.11964 12.9913 4.5402 12.5657 4.11468C12.1402 3.68916 11.5608 3.45218 10.9541 3.45557Z" fill="currentColor"></path></g><defs><clippath id="clip0_6401_1558"><rect width="16" height="16" fill="currentColor" transform="translate(0 0.5)"></rect></clippath></defs></svg></div></div><div class="home-products_image-wrap"><img src="/images/skyrule-dest-london.jpg" loading="lazy" alt="Big Ben and Westminster Bridge at golden hour" class="home-products_image"/><div class="home-products_image-overlay"></div></div></a>
    <a data-theme="dark" href="/contact" class="home-products_card w-inline-block"><div class="home-products_content-top"><div class="home-products_text-wrap"><div class="home-products_header-wrap"><h2 class="home-product_header">Paris</h2></div><div class="home-products_body-wrap"><div class="text-size-regular">From the Eiffel Tower to corner cafés, the city of light does romance, art and food like nowhere else.</div></div></div><div class="home-products_icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 17" fill="none"><g clip-path="url(#clip0_6401_1558)"><path d="M10.9541 3.45557L6.00455 3.49545L5.99226 5.02155L10.5927 4.98503L3.05492 12.5549L4.12551 13.6255L11.6959 6.02298L11.6583 10.6887L13.1844 10.6764L13.2249 5.72629C13.2282 5.11964 12.9913 4.5402 12.5657 4.11468C12.1402 3.68916 11.5608 3.45218 10.9541 3.45557Z" fill="currentColor"></path></g><defs><clippath id="clip0_6401_1558"><rect width="16" height="16" fill="currentColor" transform="translate(0 0.5)"></rect></clippath></defs></svg></div></div><div class="home-products_image-wrap"><img src="/images/skyrule-dest-paris.jpg" loading="lazy" alt="The Eiffel Tower seen from a Parisian street" class="home-products_image"/><div class="home-products_image-overlay"></div></div></a>
    <a data-theme="dark" href="/contact" class="home-products_card w-inline-block"><div class="home-products_content-top"><div class="home-products_text-wrap"><div class="home-products_header-wrap"><h2 class="home-product_header">New York</h2></div><div class="home-products_body-wrap"><div class="text-size-regular">Broadway lights, skyline views and five boroughs of energy — more in a weekend than most places manage in a month.</div></div></div><div class="home-products_icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 17" fill="none"><g clip-path="url(#clip0_6401_1558)"><path d="M10.9541 3.45557L6.00455 3.49545L5.99226 5.02155L10.5927 4.98503L3.05492 12.5549L4.12551 13.6255L11.6959 6.02298L11.6583 10.6887L13.1844 10.6764L13.2249 5.72629C13.2282 5.11964 12.9913 4.5402 12.5657 4.11468C12.1402 3.68916 11.5608 3.45218 10.9541 3.45557Z" fill="currentColor"></path></g><defs><clippath id="clip0_6401_1558"><rect width="16" height="16" fill="currentColor" transform="translate(0 0.5)"></rect></clippath></defs></svg></div></div><div class="home-products_image-wrap"><img src="/images/skyrule-dest-new-york.jpg" loading="lazy" alt="Brooklyn Bridge with the Manhattan skyline behind" class="home-products_image"/><div class="home-products_image-overlay"></div></div></a>
    <a data-theme="dark" href="/contact" class="home-products_card w-inline-block"><div class="home-products_content-top"><div class="home-products_text-wrap"><div class="home-products_header-wrap"><h2 class="home-product_header">Santorini</h2></div><div class="home-products_body-wrap"><div class="text-size-regular">White-washed villages above a deep-blue caldera — slow days, golden sunsets and honeymoon-grade views.</div></div></div><div class="home-products_icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 17" fill="none"><g clip-path="url(#clip0_6401_1558)"><path d="M10.9541 3.45557L6.00455 3.49545L5.99226 5.02155L10.5927 4.98503L3.05492 12.5549L4.12551 13.6255L11.6959 6.02298L11.6583 10.6887L13.1844 10.6764L13.2249 5.72629C13.2282 5.11964 12.9913 4.5402 12.5657 4.11468C12.1402 3.68916 11.5608 3.45218 10.9541 3.45557Z" fill="currentColor"></path></g><defs><clippath id="clip0_6401_1558"><rect width="16" height="16" fill="currentColor" transform="translate(0 0.5)"></rect></clippath></defs></svg></div></div><div class="home-products_image-wrap"><img src="/images/skyrule-dest-santorini.jpg" loading="lazy" alt="Blue-domed churches and white houses of Oia, Santorini" class="home-products_image"/><div class="home-products_image-overlay"></div></div></a>
    <a data-theme="dark" href="/contact" class="home-products_card w-inline-block"><div class="home-products_content-top"><div class="home-products_text-wrap"><div class="home-products_header-wrap"><h2 class="home-product_header">Rome</h2></div><div class="home-products_body-wrap"><div class="text-size-regular">Ancient ruins, Vatican treasures and the best pasta of your life, all within walking distance.</div></div></div><div class="home-products_icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 17" fill="none"><g clip-path="url(#clip0_6401_1558)"><path d="M10.9541 3.45557L6.00455 3.49545L5.99226 5.02155L10.5927 4.98503L3.05492 12.5549L4.12551 13.6255L11.6959 6.02298L11.6583 10.6887L13.1844 10.6764L13.2249 5.72629C13.2282 5.11964 12.9913 4.5402 12.5657 4.11468C12.1402 3.68916 11.5608 3.45218 10.9541 3.45557Z" fill="currentColor"></path></g><defs><clippath id="clip0_6401_1558"><rect width="16" height="16" fill="currentColor" transform="translate(0 0.5)"></rect></clippath></defs></svg></div></div><div class="home-products_image-wrap"><img src="/images/skyrule-dest-rome.jpg" loading="lazy" alt="The Colosseum in Rome under a dramatic sky" class="home-products_image"/><div class="home-products_image-overlay"></div></div></a>
    <a data-theme="dark" href="/contact" class="home-products_card w-inline-block"><div class="home-products_content-top"><div class="home-products_text-wrap"><div class="home-products_header-wrap"><h2 class="home-product_header">Cape Town</h2></div><div class="home-products_body-wrap"><div class="text-size-regular">Table Mountain sunsets, winelands and whale-watching — Africa’s most beautiful city break.</div></div></div><div class="home-products_icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 17" fill="none"><g clip-path="url(#clip0_6401_1558)"><path d="M10.9541 3.45557L6.00455 3.49545L5.99226 5.02155L10.5927 4.98503L3.05492 12.5549L4.12551 13.6255L11.6959 6.02298L11.6583 10.6887L13.1844 10.6764L13.2249 5.72629C13.2282 5.11964 12.9913 4.5402 12.5657 4.11468C12.1402 3.68916 11.5608 3.45218 10.9541 3.45557Z" fill="currentColor"></path></g><defs><clippath id="clip0_6401_1558"><rect width="16" height="16" fill="currentColor" transform="translate(0 0.5)"></rect></clippath></defs></svg></div></div><div class="home-products_image-wrap"><img src="/images/skyrule-dest-cape-town.jpg" loading="lazy" alt="Table Mountain rising over the city of Cape Town" class="home-products_image"/><div class="home-products_image-overlay"></div></div></a>
    <a data-theme="dark" href="/contact" class="home-products_card w-inline-block"><div class="home-products_content-top"><div class="home-products_text-wrap"><div class="home-products_header-wrap"><h2 class="home-product_header">Berlin</h2></div><div class="home-products_body-wrap"><div class="text-size-regular">History and nightlife by the block — Europe’s most storied capital, effortlessly walkable.</div></div></div><div class="home-products_icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 17" fill="none"><g clip-path="url(#clip0_6401_1558)"><path d="M10.9541 3.45557L6.00455 3.49545L5.99226 5.02155L10.5927 4.98503L3.05492 12.5549L4.12551 13.6255L11.6959 6.02298L11.6583 10.6887L13.1844 10.6764L13.2249 5.72629C13.2282 5.11964 12.9913 4.5402 12.5657 4.11468C12.1402 3.68916 11.5608 3.45218 10.9541 3.45557Z" fill="currentColor"></path></g><defs><clippath id="clip0_6401_1558"><rect width="16" height="16" fill="currentColor" transform="translate(0 0.5)"></rect></clippath></defs></svg></div></div><div class="home-products_image-wrap"><img src="/images/skyrule-dest-berlin.jpg" loading="lazy" alt="The Brandenburg Gate in Berlin" class="home-products_image"/><div class="home-products_image-overlay"></div></div></a>
  </div></div></div></section>
</BaseLayout>
