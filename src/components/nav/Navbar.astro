---
// Navbar — exact benchmark markup from drivelodge.co.uk
// Depends on: /styles/drivelodge.css or style.css
// startScrolled: pins the dark-blur .is-scrolled state from load. Use on pages
// whose first section has a light background (white nav text would otherwise be
// invisible until the scroll effect kicks in). Default keeps the benchmark
// behavior: transparent at top, dark blur after 100px of scroll.
import Button from '../button/Button.astro';

interface Props {
  startScrolled?: boolean;
}
const { startScrolled = false } = Astro.props;
---

<style>
.navbar_background {
  background-color: rgba(0, 0, 0, 0);
  backdrop-filter: blur(0px);
  -webkit-backdrop-filter: blur(0px);
  transition: background-color 0.3s ease, backdrop-filter 0.3s ease, -webkit-backdrop-filter 0.3s ease;
}
.navbar_component.is-scrolled .navbar_background {
  background-color: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

/* Mobile menu drawer background */
.navbar_menu[data-nav-menu-open] {
  background-color: rgba(0, 0, 0, 0.95);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

/* Subtle dividers in mobile menu */
.navbar_menu .navbar_link {
  border-bottom-color: rgba(255, 255, 255, 0.12);
}

/* Dropdown cards — remove any bright borders, keep them clean on dark bg */
.navbar_menu .home-products_card {
  border: none;
}

/* Services dropdown — flow in document, don't overlap bottom buttons on
   mobile. MOBILE-ONLY: left unscoped, this also de-absolutized the desktop
   mega-panel, making the navbar grow to the panel's height and scattering
   the logo/menu items whenever the dropdown opened. */
@media (max-width: 991px) {
  .navbar_menu .navbar9_dropdown-list.w--open {
    position: relative;
    z-index: 0;
  }
}
</style>

