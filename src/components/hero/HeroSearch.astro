---
// Hero flight/hotel enquiry widget — travelbeta.com-style tabbed search bar,
// built as LEAD CAPTURE: Skyrule has no live booking engine, so the traveller
// describes the trip and the request is emailed to the team via the
// FormSubmit relay (no backend required; see the submit handler). The inbox
// owner must click FormSubmit's one-time activation link, which arrives with
// the first real submission.
// Sits in the hero title layer, which is locked to 100svh on desktop, so the
// bar stays compact: one small-controls row + one main field row.
---
<style>
  .hero-search {
    width: 100%;
    max-width: 64rem; /* centered under the (also centered) hero copy instead of spanning the full container */
    margin-inline: auto;
    background-color: rgba(10, 14, 8, 0.62);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 1rem;
    padding: 1.25rem;
  }
  .hero-search_top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .hero-search_tabs { display: flex; gap: 0.5rem; }
  .hero-search_tab {
    font-size: var(--text-s);
    color: rgba(255, 255, 255, 0.85);
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 0.5rem;
    padding: 0.55rem 1.1rem;
    cursor: pointer;
  }
  .hero-search_tab.is-active {
    background-color: var(--skyrule--green);
    border-color: var(--skyrule--green);
    color: var(--skyrule--ink);
  }
  .hero-search_minis { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .hero-search_minis[hidden] { display: none; } /* display:flex would otherwise defeat the hidden attribute */
  .hero-search_mini {
    font-size: var(--text-s);
    color: #fff;
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
  }
  .hero-search_mini option { color: #000; }
  .hero-search_fields {
    display: grid;
    grid-template-columns: 1.2fr 1.2fr 1fr 1fr auto;
    gap: 0.75rem;
    align-items: end;
  }
  .hero-search_fields.is-hotels {
    grid-template-columns: 2fr 1fr 1fr auto;
  }
  /* Fields use the contact page's exact anatomy: .form_field-label +
     .form_input.w-input from the design system. Labels inherit the dark
     theme's white text; inputs keep the system's 3.75rem height. */
  .hero-search :global(.form_field-wrapper) { display: flex; flex-direction: column; }
  /* Date fields: flatpickr's altInput carries the same .form_input skin;
     a custom calendar glyph sits inside the field (the native indicator
     is gone with the native picker). */
  .is-date :global(.form_input) { padding-right: 2.75rem; }
  /* flatpickr's display input is readonly (click-to-open), which Webflow
     skins grey — keep it matching the white text inputs */
  .is-date :global(.form_input[readonly]) {
    background-color: var(--base-color-neutral--white);
    cursor: pointer;
  }
  .hero-search_cal {
    position: absolute;
    right: 1rem;
    bottom: 1.3rem; /* centers the 18px glyph in the 3.75rem input */
    color: #66707a;
    pointer-events: none;
  }
  .hero-search :global(.form_input:disabled) {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .hero-search_submit {
    min-height: 3.75rem;
    font-size: var(--text-s);
    color: var(--skyrule--ink);
    background-color: var(--skyrule--green);
    border: none;
    border-radius: 0.5rem;
    padding: 0 1.4rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .hero-search_submit:hover { background-color: var(--skyrule--green-hover); }
  .hero-search_submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .hero-search_error {
    margin-top: 1rem;
    color: #ffb4a8;
    font-size: var(--text-s);
  }
  .hero-search_error a { color: var(--skyrule--green); }
  .hero-search_success { display: none; color: #fff; }
  .hero-search_success .heading-style-h6 { margin-bottom: 0.25rem; }
  .hero-search_reset {
    color: var(--skyrule--green);
    background: none;
    border: none;
    padding: 0;
    margin-top: 0.5rem;
    cursor: pointer;
    text-decoration: underline;
    font-size: var(--text-s);
  }
  .hero-search.is-done .hero-search_top,
  .hero-search.is-done form { display: none; }
  .hero-search.is-done .hero-search_success { display: block; }
  [data-panel] { display: none; }
  [data-panel].is-active { display: block; }
  @media (max-width: 991px) {
    .hero-search_fields,
    .hero-search_fields.is-hotels { grid-template-columns: 1fr 1fr; }
    .hero-search_submit { grid-column: 1 / -1; }
  }
  @media (max-width: 479px) {
    .hero-search_fields,
    .hero-search_fields.is-hotels { grid-template-columns: 1fr; }
  }
</style>
<style is:global>
  /* shadcn-style skin for the flatpickr popup (rendered at body level, so
     these can't be component-scoped; the `body` prefix outranks flatpickr's
     own stylesheet, which loads later in the document). Zinc neutrals from
     shadcn's default theme; the selected day uses the site primary (Skyrule
     green) the way a shadcn theme would. */
  body .flatpickr-calendar {
    width: auto;
    padding: 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid #e4e4e7;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  }
  /* shadcn popovers have no caret arrow */
  body .flatpickr-calendar::before,
  body .flatpickr-calendar::after { display: none; }

  /* Header: static "July 2026" + square ghost chevron buttons */
  body .flatpickr-months { align-items: center; margin-bottom: 0.5rem; }
  body .flatpickr-months .flatpickr-month { color: #09090b; height: 2rem; }
  body .flatpickr-current-month {
    font-size: 0.875rem;
    font-weight: 500;
    color: #09090b;
    padding-top: 0.35rem;
  }
  body .flatpickr-current-month .cur-month { font-weight: 500; margin-right: 0.4ch; }
  body .flatpickr-current-month .cur-month:hover { background: none; }
  body .flatpickr-current-month input.cur-year { font-weight: 500; }
  body .flatpickr-current-month .numInputWrapper:hover { background: none; }
  body .flatpickr-current-month .numInputWrapper span { display: none; } /* year spinners */
  body .flatpickr-months .flatpickr-prev-month,
  body .flatpickr-months .flatpickr-next-month {
    top: 0.75rem;
    height: 1.75rem;
    width: 1.75rem;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #e4e4e7;
    border-radius: 0.375rem;
    color: #09090b;
  }
  body .flatpickr-months .flatpickr-prev-month { left: 0.75rem; }
  body .flatpickr-months .flatpickr-next-month { right: 0.75rem; }
  /* flatpickr hides an out-of-range month arrow; shadcn shows it disabled */
  body .flatpickr-months .flatpickr-prev-month.flatpickr-disabled,
  body .flatpickr-months .flatpickr-next-month.flatpickr-disabled {
    display: flex;
    opacity: 0.4;
    pointer-events: none;
  }
  body .flatpickr-months .flatpickr-prev-month:hover,
  body .flatpickr-months .flatpickr-next-month:hover { background: #f4f4f5; color: #09090b; }
  body .flatpickr-months .flatpickr-prev-month svg,
  body .flatpickr-months .flatpickr-next-month svg { width: 0.875rem; height: 0.875rem; fill: currentColor; }
  body .flatpickr-months .flatpickr-prev-month:hover svg,
  body .flatpickr-months .flatpickr-next-month:hover svg { fill: currentColor; }

  /* Muted weekday labels */
  body span.flatpickr-weekday { color: #71717a; font-size: 0.8rem; font-weight: 400; }

  /* 7-column grid at exactly 7 × 36px (shadcn's w-9 cells). Without this,
     the 36px max-width beats flatpickr's 14.28% flex-basis and rows wrap at
     8 cells, misaligning days from the weekday header. */
  body .flatpickr-days { width: 252px; }
  body .dayContainer { width: 252px; min-width: 252px; max-width: 252px; }

  /* Day cells: square, rounded-md */
  body .flatpickr-day {
    height: 2.25rem;
    max-width: 2.25rem;
    line-height: 2.25rem;
    border-radius: 0.375rem;
    border: none;
    font-size: 0.875rem;
    color: #09090b;
  }
  body .flatpickr-day:hover,
  body .flatpickr-day:focus,
  body .flatpickr-day.prevMonthDay:hover,
  body .flatpickr-day.nextMonthDay:hover { background: #f4f4f5; }
  body .flatpickr-day.today { background: #f4f4f5; color: #09090b; }
  body .flatpickr-day.selected,
  body .flatpickr-day.selected:focus,
  body .flatpickr-day.selected:hover {
    background: var(--skyrule--green);
    color: var(--skyrule--ink);
    font-weight: 500;
  }
  body .flatpickr-day.prevMonthDay,
  body .flatpickr-day.nextMonthDay { color: #a1a1aa; }
  body .flatpickr-day.flatpickr-disabled,
  body .flatpickr-day.flatpickr-disabled:hover { color: #d4d4d8; background: none; }
</style>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css"/>
<script is:inline src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>

<div class="hero-search">
  <div class="hero-search_top">
    <div class="hero-search_tabs" role="tablist" aria-label="What do you need?">
      <button type="button" role="tab" aria-selected="true" class="hero-search_tab is-active" data-tab="flights">Flights</button>
      <button type="button" role="tab" aria-selected="false" class="hero-search_tab" data-tab="hotels">Hotels</button>
    </div>
    <div class="hero-search_minis" data-minis="flights">
      <select class="hero-search_mini" name="trip-type" aria-label="Trip type">
        <option>Round trip</option>
        <option>One way</option>
      </select>
      <select class="hero-search_mini" name="travellers" aria-label="Travellers">
        <option>1 traveller</option>
        <option>2 travellers</option>
        <option>3 travellers</option>
        <option>4 travellers</option>
        <option>5+ travellers</option>
      </select>
      <select class="hero-search_mini" name="cabin" aria-label="Cabin class">
        <option>Economy</option>
        <option>Premium Economy</option>
        <option>Business</option>
        <option>First</option>
      </select>
    </div>
    <div class="hero-search_minis" data-minis="hotels" hidden>
      <select class="hero-search_mini" name="rooms" aria-label="Rooms">
        <option>1 room</option>
        <option>2 rooms</option>
        <option>3+ rooms</option>
      </select>
      <select class="hero-search_mini" name="guests" aria-label="Guests">
        <option>1 guest</option>
        <option>2 guests</option>
        <option>3 guests</option>
        <option>4+ guests</option>
      </select>
    </div>
  </div>

  <form data-panel="flights" class="is-active" novalidate>
    <div class="hero-search_fields">
      <div class="form_field-wrapper">
        <label for="hs-from" class="form_field-label is-alternate">From*</label>
        <input class="form_input w-input" maxlength="256" name="from" placeholder="Lagos (LOS)" type="text" id="hs-from" required/>
      </div>
      <div class="form_field-wrapper">
        <label for="hs-to" class="form_field-label is-alternate">To*</label>
        <input class="form_input w-input" maxlength="256" name="to" placeholder="London (LHR)" type="text" id="hs-to" required/>
      </div>
      <div class="form_field-wrapper is-date">
        <label for="hs-depart" class="form_field-label is-alternate">Departure*</label>
        <input class="form_input w-input" name="departure" type="date" id="hs-depart" required/>
        <svg class="hero-search_cal" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="M3 10h18" stroke="currentColor" stroke-width="1.6"/><path d="M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </div>
      <div class="form_field-wrapper is-date">
        <label for="hs-return" class="form_field-label is-alternate">Return</label>
        <input class="form_input w-input" name="return" type="date" id="hs-return"/>
        <svg class="hero-search_cal" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="M3 10h18" stroke="currentColor" stroke-width="1.6"/><path d="M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </div>
      <button type="submit" class="hero-search_submit">Request quote</button>
    </div>
  </form>

  <form data-panel="hotels" novalidate>
    <div class="hero-search_fields is-hotels">
      <div class="form_field-wrapper">
        <label for="hs-city" class="form_field-label is-alternate">Destination*</label>
        <input class="form_input w-input" maxlength="256" name="destination" placeholder="City or hotel" type="text" id="hs-city" required/>
      </div>
      <div class="form_field-wrapper is-date">
        <label for="hs-checkin" class="form_field-label is-alternate">Check-in*</label>
        <input class="form_input w-input" name="check-in" type="date" id="hs-checkin" required/>
        <svg class="hero-search_cal" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="M3 10h18" stroke="currentColor" stroke-width="1.6"/><path d="M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </div>
      <div class="form_field-wrapper is-date">
        <label for="hs-checkout" class="form_field-label is-alternate">Check-out</label>
        <input class="form_input w-input" name="check-out" type="date" id="hs-checkout"/>
        <svg class="hero-search_cal" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="M3 10h18" stroke="currentColor" stroke-width="1.6"/><path d="M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </div>
      <button type="submit" class="hero-search_submit">Request quote</button>
    </div>
  </form>

  <div class="hero-search_error" hidden role="alert">Something went wrong sending your request. Please try again, or reach us directly at <a href="mailto:enquiries@skyruletravels.com">enquiries@skyruletravels.com</a> or <a href="tel:+2348061659861">0806 165 9861</a>.</div>

  <div class="hero-search_success" role="status">
    <div class="heading-style-h6">Request received</div>
    <div class="text-size-regular">A Skyrule travel expert will get back to you within one business day.</div>
    <button type="button" class="hero-search_reset">Plan another trip</button>
  </div>
</div>

<script>
  const root = document.querySelector(".hero-search");

  // Tab switching (values persist across switches)
  const tabs = root.querySelectorAll(".hero-search_tab");
  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      tabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle("is-active", active);
        t.setAttribute("aria-selected", String(active));
      });
      root.querySelectorAll("[data-panel]").forEach((p) =>
        p.classList.toggle("is-active", p.dataset.panel === tab.dataset.tab));
      root.querySelectorAll("[data-minis]").forEach((m) =>
        (m.hidden = m.dataset.minis !== tab.dataset.tab));
    });
  });

  // Modern calendar popups (flatpickr): friendly display format on a visible
  // altInput that carries the design system's input skin, ISO value on the
  // original (named) input, no past dates, and the return/check-out pickers
  // can't precede the outbound date.
  const dateOpts = {
    altInput: true,
    altInputClass: "form_input w-input",
    altFormat: "j M Y",
    dateFormat: "Y-m-d",
    minDate: "today",
    disableMobile: true,
    monthSelectorType: "static", // plain "July 2026" header, shadcn-style
  };
  const fpReturn = flatpickr("#hs-return", dateOpts);
  const fpDepart = flatpickr("#hs-depart", { ...dateOpts, onChange: (d) => d[0] && fpReturn.set("minDate", d[0]) });
  const fpCheckout = flatpickr("#hs-checkout", dateOpts);
  flatpickr("#hs-checkin", { ...dateOpts, onChange: (d) => d[0] && fpCheckout.set("minDate", d[0]) });
  document.querySelectorAll(".hero-search input.flatpickr-input").forEach((i) => {
    const fp = i._flatpickr;
    fp.altInput.placeholder = "Select date";
    fp.altInput.required = fp.input.required; // so empty-field validity bubbles show on the visible input
  });

  // One-way trips have no return date
  const tripType = root.querySelector('[name="trip-type"]');
  tripType.addEventListener("change", () => {
    const oneWay = tripType.value === "One way";
    if (oneWay) fpReturn.clear();
    fpReturn.altInput.disabled = oneWay;
  });

  // Submit — the enquiry is emailed to Skyrule via the FormSubmit relay
  // (free, no backend; the inbox owner clicks a one-time activation link
  // that arrives with the first submission). To move to a serverless
  // sender later, only ENDPOINT and the fetch below need to change.
  const ENDPOINT = "https://formsubmit.co/ajax/enquiries@skyruletravels.com";
  root.querySelectorAll("form[data-panel]").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      let valid = true;
      form.querySelectorAll("[required]").forEach((f) => {
        if (!f.value.trim()) { f.reportValidity(); valid = false; }
      });
      if (!valid) return;
      const payload = Object.fromEntries(new FormData(form));
      payload.kind = form.dataset.panel;
      root.querySelectorAll("[data-minis]:not([hidden]) select").forEach((s) => (payload[s.name] = s.value));
      payload._subject = payload.kind === "flights"
        ? `Flight quote request: ${payload.from} -> ${payload.to}`
        : `Hotel quote request: ${payload.destination}`;
      payload._template = "table";
      payload._captcha = "false";

      const btn = form.querySelector(".hero-search_submit");
      const label = btn.textContent;
      const errorBox = root.querySelector(".hero-search_error");
      btn.disabled = true;
      btn.textContent = "Sending…";
      errorBox.hidden = true;
      try {
        const res = await fetch(ENDPOINT, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error(String(res.status));
        root.classList.add("is-done");
      } catch {
        errorBox.hidden = false;
      } finally {
        btn.disabled = false;
        btn.textContent = label;
      }
    });
  });

  root.querySelector(".hero-search_reset").addEventListener("click", () => root.classList.remove("is-done"));
</script>
