---
// Skyrule Hero — exact Drivelodge classes + structure
// Parallax layers, hero content, product type cards inside
---
<header data-theme="dark" class="section_hero-home">
  <div class="code-embed-css w-embed">
    <link rel="stylesheet" href="https://unpkg.com/lenis@1.1.14/dist/lenis.css"/>
    <style>
      :root { --color-dark-rgb: 0, 0, 0; }
      .parallax__fade { background: linear-gradient(to top, rgba(var(--color-dark-rgb), 1) 0%, rgba(var(--color-dark-rgb), 0.738) 19%, rgba(var(--color-dark-rgb), 0.541) 34%, rgba(var(--color-dark-rgb), 0.382) 47%, rgba(var(--color-dark-rgb), 0.278) 56.5%, rgba(var(--color-dark-rgb), 0.194) 65%, rgba(var(--color-dark-rgb), 0.126) 73%, rgba(var(--color-dark-rgb), 0.075) 80.2%, rgba(var(--color-dark-rgb), 0.042) 86.1%, rgba(var(--color-dark-rgb), 0.021) 91%, rgba(var(--color-dark-rgb), 0.008) 95.2%, rgba(var(--color-dark-rgb), 0.002) 98.2%, rgba(var(--color-dark-rgb), 0) 100%); }
    </style>
  </div>

  <!-- Parallax visual layers -->
  <section class="parallax__header">
    <div class="parallax__visuals">
      <div class="parallax__black-line-overflow"></div>
      <div class="parallax__layers">
        <img width="2880" data-parallax-layer="4" alt="" src="/images/hero-mountains.webp" loading="eager" class="parallax__layer-img"/>
        <img width="800" data-parallax-layer="4" alt="" src="/images/hero-ground.webp" loading="eager" class="parallax__layer-img hide-tablet"/>
        <img width="1200" data-parallax-layer="2" alt="" src="/images/hero-van.webp" loading="eager" class="parallax__layer-img is--van"/>
      </div>
    </div>
    <div class="parallax__fade hide-tablet"></div>
  </section>

  <!-- Hero content + product cards -->
  <section class="parallax__content">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-large">
          <div class="hero-home_content">
            <div class="hero-home_header-wrap">
              <div class="header-eyebrow-text">Skyrule — Raising the roof on standards.</div>
              <h1 class="heading-style-h1">High Top &amp; Elevating Roof Conversions</h1>
              <div class="spacer-medium"></div>
              <div class="button-group">
                <a href="/contact" class="button-wrap w-inline-block">
                  <div class="button-content"><div class="button-layout"><div class="button-text">Get in touch</div></div></div>
                </a>
                <a href="/products" class="button-wrap is--alt w-inline-block">
                  <div class="button-content"><div class="button-layout"><div class="button-text">Search by model</div></div></div>
                </a>
              </div>
            </div>
            <div class="hero-home_button-wrap">
              <a href="#" class="hero-home_lightbox-button w-inline-block w-lightbox">
                <div class="hero-home_play-icon">
                  <svg width="24" height="24" viewBox="0 0 16 17" fill="currentColor"><path d="M4 1l11 7.5L4 16V1z"/></svg>
                </div>
                <div class="hero-home_lightbox-text">
                  <div>The Story of Skyrule</div>
                  <div class="text-size-small">Watch Video</div>
                </div>
              </a>
            </div>
          </div>

          <!-- Product type cards — inside hero -->
          <div class="home-products_component">
            <a href="/products?roof=Elevated+Roof" class="home-products_card w-inline-block">
              <div class="home-products_content-top">
                <div class="home-products_text-wrap">
                  <div class="home-products_header-wrap">
                    <h2 class="home-product_header">Elevated Roof</h2>
                    <div class="home-products_icon"><div>32</div></div>
                  </div>
                  <div class="home-products_body-wrap">
                    <div class="text-size-regular">Browse our front and rear elevating roofs by make and model.</div>
                  </div>
                </div>
              </div>
              <div class="home-products_image-wrap">
                <img src="/images/elevated-roof.webp" loading="lazy" alt="" class="home-products_image"/>
                <div class="home-products_image-overlay"></div>
              </div>
            </a>
            <a href="/products?roof=High+Top+Roof" class="home-products_card w-inline-block">
              <div class="home-products_content-top">
                <div class="home-products_text-wrap">
                  <div class="home-products_header-wrap">
                    <h2 class="home-product_header">High-top Roof</h2>
                    <div class="home-products_icon"><div>12</div></div>
                  </div>
                  <div class="home-products_body-wrap">
                    <div class="text-size-regular">Browse high top roof conversions by make and model.</div>
                  </div>
                </div>
              </div>
              <div class="home-products_image-wrap">
                <img src="/images/high-top-roof.webp" loading="lazy" alt="" class="home-products_image"/>
                <div class="home-products_image-overlay"></div>
              </div>
            </a>
          </div>

        </div>
      </div>
    </div>
  </section>
</header>
