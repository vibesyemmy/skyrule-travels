---
// Skyrule Hero — literal benchmark structure/classes, Skyrule brand copy.
// The benchmark's layered parallax cutouts (mountains/van/rocks) are replaced
// by ONE static background photo on .parallax__visuals at every width — the
// same mechanism the benchmark itself used below 992px (where it still
// pointed at Drivelodge CDN photos). The GSAP parallax script was removed
// from index.astro with the layers; the hero no longer animates on scroll.
import Button from '../button/Button.astro';
import HeroSearch from './HeroSearch.astro';
---
<style>
  /* Single hero photo at all sizes, with a legibility scrim painted over it
     (multi-background keeps the scrim behind all children, so the title and
     buttons are never covered). Overrides the benchmark's tablet/mobile
     Drivelodge CDN background-images via Astro's scoped-style specificity. */
  .parallax__visuals {
    background-image:
      linear-gradient(to bottom, rgba(0, 0, 0, 0.38) 0%, rgba(0, 0, 0, 0.18) 45%, rgba(0, 0, 0, 0.42) 100%),
      url('/images/hero-BG.jpg');
    background-position: 50% 50%, 50% 42%;
    background-size: cover, cover;
  }
  /* Hero sizing, all widths: exactly one screen tall, growing with content
     when it doesn't fit (the benchmark instead locked the header to 120svh
     with the visuals overhanging the next section by 24svh — which needed
     an artificial clearance padding on the cards section, now removed from
     skyrule.css). The whole layer chain sits in normal flow; the visuals
     div paints the photo and centers the content when the screen is taller
     than it. */
  .parallax__header { height: auto; min-height: 0; max-height: none; }
  .parallax__visuals {
    position: relative;
    height: auto;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .parallax__layers { position: relative; height: auto; overflow: visible; }
  .parallax__layer-title { position: relative; height: auto; }
  /* The benchmark also puts Drivelodge CDN photos on .parallax itself at
     tablet/mobile — invisible behind our visuals, but still downloaded. */
  .parallax { background-image: none; }
  /* Centered hero: copy and search bar sit on the page axis (the benchmark
     lays the hero out left-aligned; buttons were removed with the change). */
  .hero-home_content { justify-content: center; } /* row flex: its single child shrinks to fit and sat at flex-start */
  /* Full-width chain down to the search card: with the shrink-to-fit default,
     the card hugged whichever tab panel was active and jumped width on switch. */
  .hero-home_content > .padding-section-large.is-hero-home { width: 100%; }
  .hero-home_component {
    width: 100%;
    align-items: center;
    /* The benchmark space-betweens the column (title top, card bottom),
       stretching a huge gap between copy and form — cluster them instead. */
    justify-content: center;
    grid-row-gap: 2.5rem;
    row-gap: 2.5rem;
  }
  .max-width-hero { text-align: center; }
  .max-width-hero .header-wrapper,
  .max-width-hero .header-text-wrap,
  .max-width-hero .header-top { align-items: center; }
  /* Services section: intro header above the 4-card grid, centered
     see-more button below (the full ten live on /services). */
  .hero-services_header {
    max-width: 64ch;
    margin-bottom: 3rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .hero-services_header .body-text { opacity: 0.8; }
  .hero-services_footer {
    display: flex;
    justify-content: center;
    margin-top: 3.5rem;
  }
  /* Dark fade at the bottom of the hero, from benchmark's style.css (dropped during the initial markup port) */
  .parallax__fade {
    background: linear-gradient(to top, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.738) 19%, rgba(0, 0, 0, 0.541) 34%, rgba(0, 0, 0, 0.382) 47%, rgba(0, 0, 0, 0.278) 56.5%, rgba(0, 0, 0, 0.194) 65%, rgba(0, 0, 0, 0.126) 73%, rgba(0, 0, 0, 0.075) 80.2%, rgba(0, 0, 0, 0.042) 86.1%, rgba(0, 0, 0, 0.021) 91%, rgba(0, 0, 0, 0.008) 95.2%, rgba(0, 0, 0, 0.002) 98.2%, transparent 100%);
  }

  /* Hero background: plane taking off from airport, with a dark scrim
     layered over it (multi-background keeps it behind all children) so the
     hero copy stays legible against the bright sky. */
  .parallax__visuals {
    background-image:
      linear-gradient(to bottom, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0.3) 50%, rgba(0, 0, 0, 0.45) 100%),
      url('/images/hero-plane-bg.jpg');
    background-position: 50% 50%, 50% 50%;
    background-size: cover, cover;
  }
</style>
<header data-theme="dark" class="section_hero-home">
  <div class="parallax">
    <section class="parallax__header">
      <div class="parallax__visuals">
        <div class="parallax__black-line-overflow"></div>
        <div class="parallax__layers">
          <div class="parallax__layer-title">
            <div class="padding-global">
              <div class="container-large">
                <div class="hero-home_content">
                  <div class="padding-section-large is-hero-home">
                    <div class="hero-home_component">
                      <div class="max-width-hero">
                        <div class="header-wrapper">
                          <div class="header-text-wrap">
                            <div class="header-top">
                              <div class="header-eyebrow-text">Skyrule Travels — beyond your dream, within your reach.</div>
                              <h1 class="heading-style">Discover Your Next Destination.</h1>
                            </div>
                            <div class="hero_text-wrap"><p class="body-text">Explore the world's most captivating places with exclusive travel offers.</p></div>
                          </div>
                        </div>
                      </div>
                      <HeroSearch />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="parallax__fade"></div>
      </div>
    </section>
    <section class="parallax__content">
      <div class="padding-global">
        <div class="container-large">
          <div class="padding-section-large">
            <div class="hero-services_header">
              <h2 class="heading-style-h3">Welcome to Skyrule</h2>
              <p class="body-text">Skyrule Travels is a Lagos-based travel management company — established in 2016, fully registered and IATA-accredited. From flights, hotels and visas to charters, protocol and airport pick-ups, we handle every part of the journey for individuals, families and businesses.</p>
            </div>
            <div class="home-products_component">
              <a data-theme="dark" href="/services" class="home-products_card w-inline-block">
                <div class="home-products_content-top">
                  <div class="home-products_text-wrap">
                    <div class="home-products_header-wrap">
                      <h2 class="home-product_header">Flights</h2>
                    </div>
                    <div class="home-products_body-wrap"><div class="text-size-regular">Round trip or one way — the best routes and fares, booked and managed for you.</div></div>
                  </div>
                  <div class="home-products_icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 17" fill="none"><g clip-path="url(#clip0_6401_1558)"><path d="M10.9541 3.45557L6.00455 3.49545L5.99226 5.02155L10.5927 4.98503L3.05492 12.5549L4.12551 13.6255L11.6959 6.02298L11.6583 10.6887L13.1844 10.6764L13.2249 5.72629C13.2282 5.11964 12.9913 4.5402 12.5657 4.11468C12.1402 3.68916 11.5608 3.45218 10.9541 3.45557Z" fill="currentColor"></path></g><defs><clippath id="clip0_6401_1558"><rect width="16" height="16" fill="currentColor" transform="translate(0 0.5)"></rect></clippath></defs></svg></div>
                </div>
                <div class="home-products_image-wrap">
                  <img src="/images/skyrule-svc-flights.jpg" loading="lazy" alt="Airplane on the tarmac at an airport" class="home-products_image"/>
                  <div class="home-products_image-overlay"></div>
                </div>
              </a>
              <a data-theme="dark" href="/services" class="home-products_card w-inline-block">
                <div class="home-products_content-top">
                  <div class="home-products_text-wrap">
                    <div class="home-products_header-wrap">
                      <h2 class="home-product_header">Hotels</h2>
                    </div>
                    <div class="home-products_body-wrap"><div class="text-size-regular">Stays that fit your plans and your budget, from business hotels to beach resorts.</div></div>
                  </div>
                  <div class="home-products_icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 17" fill="none"><g clip-path="url(#clip0_6401_1558)"><path d="M10.9541 3.45557L6.00455 3.49545L5.99226 5.02155L10.5927 4.98503L3.05492 12.5549L4.12551 13.6255L11.6959 6.02298L11.6583 10.6887L13.1844 10.6764L13.2249 5.72629C13.2282 5.11964 12.9913 4.5402 12.5657 4.11468C12.1402 3.68916 11.5608 3.45218 10.9541 3.45557Z" fill="currentColor"></path></g><defs><clippath id="clip0_6401_1558"><rect width="16" height="16" fill="currentColor" transform="translate(0 0.5)"></rect></clippath></defs></svg></div>
                </div>
                <div class="home-products_image-wrap">
                  <img src="/images/skyrule-svc-hotels.jpg" loading="lazy" alt="Modern hotel room with bed and artwork" class="home-products_image"/>
                  <div class="home-products_image-overlay"></div>
                </div>
              </a>
              <a data-theme="dark" href="/services" class="home-products_card w-inline-block">
                <div class="home-products_content-top">
                  <div class="home-products_text-wrap">
                    <div class="home-products_header-wrap">
                      <h2 class="home-product_header">Visa Assistance</h2>
                    </div>
                    <div class="home-products_body-wrap"><div class="text-size-regular">Applications done right the first time — documents, requirements and timelines handled.</div></div>
                  </div>
                  <div class="home-products_icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 17" fill="none"><g clip-path="url(#clip0_6401_1558)"><path d="M10.9541 3.45557L6.00455 3.49545L5.99226 5.02155L10.5927 4.98503L3.05492 12.5549L4.12551 13.6255L11.6959 6.02298L11.6583 10.6887L13.1844 10.6764L13.2249 5.72629C13.2282 5.11964 12.9913 4.5402 12.5657 4.11468C12.1402 3.68916 11.5608 3.45218 10.9541 3.45557Z" fill="currentColor"></path></g><defs><clippath id="clip0_6401_1558"><rect width="16" height="16" fill="currentColor" transform="translate(0 0.5)"></rect></clippath></defs></svg></div>
                </div>
                <div class="home-products_image-wrap">
                  <img src="/images/skyrule-svc-visa.jpg" loading="lazy" alt="Passport and travel documents on a map" class="home-products_image"/>
                  <div class="home-products_image-overlay"></div>
                </div>
              </a>
              <a data-theme="dark" href="/services" class="home-products_card w-inline-block">
                <div class="home-products_content-top">
                  <div class="home-products_text-wrap">
                    <div class="home-products_header-wrap">
                      <h2 class="home-product_header">Airport Pick-up</h2>
                    </div>
                    <div class="home-products_body-wrap"><div class="text-size-regular">Land and go — reliable transfers waiting at arrivals, wherever you're headed.</div></div>
                  </div>
                  <div class="home-products_icon-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 17" fill="none"><g clip-path="url(#clip0_6401_1558)"><path d="M10.9541 3.45557L6.00455 3.49545L5.99226 5.02155L10.5927 4.98503L3.05492 12.5549L4.12551 13.6255L11.6959 6.02298L11.6583 10.6887L13.1844 10.6764L13.2249 5.72629C13.2282 5.11964 12.9913 4.5402 12.5657 4.11468C12.1402 3.68916 11.5608 3.45218 10.9541 3.45557Z" fill="currentColor"></path></g><defs><clippath id="clip0_6401_1558"><rect width="16" height="16" fill="currentColor" transform="translate(0 0.5)"></rect></clippath></defs></svg></div>
                </div>
                <div class="home-products_image-wrap">
                  <img src="/images/skyrule-svc-pickup.jpg" loading="lazy" alt="Airport terminal with travelers and luggage" class="home-products_image"/>
                  <div class="home-products_image-overlay"></div>
                </div>
              </a>
            </div>
            <div class="hero-services_footer"><Button href="/services" label="See more services" /></div>
          </div>
        </div>
      </div>
    </section>
  </div>
</header>
