---
// Footer — benchmark markup from drivelodge.co.uk, minus the CTA block
// (heading + buttons removed per client direction; footer hugs its content).
// Depends on: /styles/drivelodge.css or style.css
const year = new Date().getFullYear();
---

<style>
  /* Without the CTA block the benchmark's full-viewport footer is mostly
     empty space: release the height lock (calc(100vh - 13rem)) so the
     component shrinks to its content, and tighten the 10rem child gap.
     The reveal spacer (.main-wrapper padding-bottom) is resized to match
     in skyrule.css. */
  .footer_component {
    height: auto;
    grid-row-gap: 4rem;
    row-gap: 4rem;
  }
  @media screen and (max-width: 479px) {
    .section_footer {
      height: auto;
      position: relative;
      inset: auto;
      margin-top: 0;
    }
    .footer_component {
      height: auto;
    }
    /* Benchmark's 479px rule sets flex-flow:column on .footer_link-list, but
       the element is display:grid (inherited from the 767px breakpoint) —
       flex-flow has no effect on a grid container, so it stayed locked to
       grid-template-columns:1fr 1fr 1fr and squished 4 columns of links
       into 3 narrow lanes. Force single-column grid so it actually stacks. */
    .footer_link-list {
      grid-template-columns: 1fr;
      row-gap: 2.5rem;
    }
  }
</style>

