---
// Footer — benchmark markup from drivelodge.co.uk, minus the CTA block
// (heading + buttons removed per client direction; footer hugs its content).
// Depends on: /styles/drivelodge.css or style.css
const year = new Date().getFullYear();
---

<style>
  /* Without the CTA block the benchmark's full-viewport footer is mostly
     empty space: release the height lock (calc(100vh - 13rem)) so the
     component shrinks to its content, and tighten the 10rem child gap.
     The reveal spacer (.main-wrapper padding-bottom) is resized to match
     in skyrule.css. */
  .footer_component {
    height: auto;
    grid-row-gap: 4rem;
    row-gap: 4rem;
  }
  @media screen and (max-width: 479px) {
    .section_footer {
      height: auto;
      position: relative;
      inset: auto;
      margin-top: 0;
    }
    .footer_component {
      height: auto;
    }
  }
</style>

